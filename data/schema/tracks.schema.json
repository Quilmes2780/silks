{
  "$id": "tracks.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tracks"],
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "direction", "circuitM", "homeStraightM", "straightCourseM", "bends", "gradient", "uphillFinish", "surfaces"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["left", "right"] },
          "circuitM": { "type": "number", "minimum": 1000, "maximum": 6000 },
          "homeStraightM": { "type": "number", "minimum": 100, "maximum": 2000 },
          "straightCourseM": { "type": "number", "minimum": 0, "maximum": 2500 },
          "bends": { "enum": ["tight", "normal", "galloping"] },
          "gradient": { "enum": ["flat", "undulating", "stiff", "downhill"] },
          "uphillFinish": { "type": "boolean" },
          "surfaces": { "type": "array", "minItems": 1, "items": { "enum": ["turf", "aw"] } },
          "note": { "type": "string" }
        }
      }
    }
  }
}
